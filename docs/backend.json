
{
  "entities": {
    "Branch": {
      "title": "Branch",
      "type": "object",
      "description": "Represents a hostel branch/location.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "Building": {
      "title": "Building",
      "type": "object",
      "description": "Represents a single hostel building.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "branch": { "type": "string" },
        "apartmentsCount": { "type": "number" },
        "apartmentsDetail": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "meterNo": { "type": "string" },
              "rooms": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "roomNo": { "type": "string" },
                    "totalSeats": { "type": "number" },
                    "seats": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "seatNo": { "type": "string" },
                          "status": { "type": "string", "enum": ["empty", "occupied"] }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "totalSeats": { "type": "number" },
        "occupiedSeats": { "type": "number" },
        "emptySeats": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "address"]
    },
    "Student": {
      "title": "Student",
      "type": "object",
      "description": "Represents a student resident.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string", "default": "Student" },
        "dob": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "fatherName": { "type": "string" },
        "motherName": { "type": "string" },
        "parentPhone": { "type": "string" },
        "guardianPhone": { "type": "string" },
        "village": { "type": "string" },
        "address": { "type": "string" },
        "buildingId": { "type": "string" },
        "buildingName": { "type": "string" },
        "branch": { "type": "string" },
        "roomNumber": { "type": "string" },
        "seatNumber": { "type": "string" },
        "apartmentName": { "type": "string" },
        "isActive": { "type": "boolean" },
        "monthlyRent": { "type": "number" },
        "advanceAmount": { "type": "number" },
        "billingStartDate": { "type": "string" },
        "paymentSystem": { "type": "string" },
        "mealStatus": { "type": "object" },
        "mealChoices": { "type": "object" },
        "currentMonthLabel": { "type": "string" },
        "currentMonthBreakfast": { "type": "number" },
        "currentMonthLunch": { "type": "number" },
        "currentMonthDinner": { "type": "number" },
        "currentMonthGuestMeals": { "type": "number" },
        "tomorrowGuestMeals": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "MealRoutine": {
      "title": "Meal Routine",
      "type": "object",
      "properties": {
        "day": { "type": "string" },
        "breakfast": { "type": "string" },
        "lunch": { "type": "string" },
        "dinner": { "type": "string" },
        "options": { "type": "object" }
      }
    },
    "MarketExpense": {
      "title": "Market Expense",
      "type": "object",
      "description": "Grocery and bazaar records.",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "category": { "type": "string" },
        "itemName": { "type": "string" },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "totalPrice": { "type": "number" },
        "purchasedBy": { "type": "string" },
        "branch": { "type": "string" }
      }
    },
    "Staff": {
      "title": "Staff",
      "type": "object",
      "description": "Represents a staff member (Management or Working).",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "role": { "type": "string" },
        "staffType": { "type": "string", "enum": ["management", "working"] },
        "monthlySalary": { "type": "number" },
        "branch": { "type": "string" },
        "assignedBuildingId": { "type": "string" },
        "password": { "type": "string" },
        "isActive": { "type": "boolean", "default": true }
      }
    }
  },
  "auth": {
    "providers": ["anonymous", "password"]
  },
  "firestore": {
    "/branches/{branchId}": { "schema": "Branch", "description": "Hostel Branches" },
    "/buildings/{buildingId}": { "schema": "Building", "description": "Buildings list" },
    "/students/{studentId}": { "schema": "Student", "description": "Residents list" },
    "/staff/{staffId}": { "schema": "Staff", "description": "Staff directory" },
    "/marketExpenses/{id}": { "schema": "MarketExpense", "description": "Bazaar tracking" },
    "/mealRoutines/{day}": { "schema": "MealRoutine", "description": "Weekly food menu" },
    "/paymentRequests/{id}": { "schema": "object", "description": "Student payment submissions" },
    "/payments/{paymentId}": { "schema": "object", "description": "Income transactions" },
    "/expenses/{expenseId}": { "schema": "object", "description": "Expense records" },
    "/managerRequests/{requestId}": { "schema": "ManagerRequest", "description": "Pending approval requests" },
    "/registrations/{regId}": { "schema": "object", "description": "Public admission forms" },
    "/configs/{configId}": { "schema": "object", "description": "Global settings" },
    "/smsLogs/{logId}": { "schema": "object", "description": "SMS history" },
    "/notices/{noticeId}": { "schema": "object", "description": "In-app notifications" },
    "/netBalance/{branchName}": { "schema": "NetBalance", "description": "Consolidated balances per branch" }
  }
}
