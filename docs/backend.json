
{
  "entities": {
    "Building": {
      "title": "Building",
      "type": "object",
      "description": "Represents a single hostel building.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "roomsCount": { "type": "number" },
        "roomsDetail": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "roomNo": { "type": "string" },
              "meterNo": { "type": "string", "description": "Electric meter number for this unit" },
              "totalSeats": { "type": "number" },
              "seats": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "seatNo": { "type": "string" },
                    "status": { "type": "string", "enum": ["empty", "occupied"] }
                  }
                }
              }
            }
          }
        },
        "totalSeats": { "type": "number" },
        "occupiedSeats": { "type": "number" },
        "emptySeats": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "address"]
    },
    "Student": {
      "title": "Student",
      "type": "object",
      "description": "Represents a student resident.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "parentPhone": { "type": "string" },
        "address": { "type": "string" },
        "buildingId": { "type": "string" },
        "buildingName": { "type": "string" },
        "roomNumber": { "type": "string" },
        "seatNumber": { "type": "string" },
        "type": { "type": "string", "enum": ["new", "old"] },
        "dueAmount": { "type": "number" },
        "advanceAmount": { "type": "number" },
        "serviceCharge": { "type": "number" },
        "isActive": { "type": "boolean" },
        "paymentSystem": { "type": "string", "enum": ["package", "non-package"] },
        "monthlyRent": { "type": "number" },
        "foodCost": { "type": "number" },
        "foodRate": { "type": "number" },
        "paymentsHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string", "format": "date-time" },
              "amount": { "type": "number" },
              "method": { "type": "string" },
              "receiver": { "type": "string" },
              "month": { "type": "string" },
              "year": { "type": "string" },
              "type": { "type": "string" }
            }
          }
        },
        "mealsHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string", "format": "date" },
              "month": { "type": "string" },
              "totalMeals": { "type": "number" },
              "perMealCost": { "type": "number" },
              "totalCost": { "type": "number" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "buildingId", "roomNumber"]
    },
    "Payment": {
      "title": "Payment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "month": { "type": "string" },
        "year": { "type": "string" },
        "studentName": { "type": "string" },
        "studentId": { "type": "string" },
        "buildingId": { "type": "string" },
        "buildingName": { "type": "string" },
        "type": { "type": "string" },
        "date": { "type": "string", "format": "date-time" }
      }
    },
    "MealRecord": {
      "title": "Meal Record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "count": { "type": "number" },
        "month": { "type": "string" },
        "year": { "type": "string" }
      }
    },
    "Staff": {
      "title": "Staff",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/buildings/{buildingId}": { "schema": "Building", "description": "Buildings list" },
    "/students/{studentId}": { "schema": "Student", "description": "Students list with embedded histories" },
    "/payments/{paymentId}": { "schema": "Payment", "description": "Global Income records" },
    "/expenses/{expenseId}": { "schema": "Expense", "description": "Global Expense records" },
    "/meals/{mealId}": { "schema": "MealRecord", "description": "Global Meal counts" },
    "/staff/{staffId}": { "schema": "Staff", "description": "List of staff/receivers" }
  }
}
