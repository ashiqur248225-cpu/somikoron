
{
  "entities": {
    "Building": {
      "title": "Building",
      "type": "object",
      "description": "Represents a single hostel building.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "roomsCount": { "type": "number", "description": "Total number of rooms" },
        "roomsDetail": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "roomNo": { "type": "string" },
              "totalSeats": { "type": "number" },
              "occupiedSeats": { "type": "number", "default": 0 }
            }
          }
        },
        "totalSeats": { "type": "number", "description": "Total capacity of seats" },
        "occupiedSeats": { "type": "number", "description": "Currently occupied seats" },
        "emptySeats": { "type": "number", "description": "Currently vacant seats" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "address", "roomsCount", "totalSeats"]
    },
    "Student": {
      "title": "Student",
      "type": "object",
      "description": "Represents a student resident.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "buildingId": { "type": "string" },
        "buildingName": { "type": "string" },
        "roomNumber": { "type": "string" },
        "seatNumber": { "type": "string" },
        "isActive": { "type": "boolean" },
        "paymentSystem": { "type": "string", "enum": ["package", "non-package"] },
        "monthlyAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "buildingId", "roomNumber"]
    },
    "Payment": {
      "title": "Payment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "month": { "type": "string" },
        "year": { "type": "string" },
        "studentName": { "type": "string" },
        "studentId": { "type": "string" },
        "buildingId": { "type": "string" },
        "buildingName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" }
      }
    },
    "Summary": {
      "title": "Monthly Summary",
      "type": "object",
      "description": "Aggregated financial data for a specific month.",
      "properties": {
        "id": { "type": "string", "description": "Format: YYYY-MonthName" },
        "totalIncome": { "type": "number" },
        "totalExpense": { "type": "number" },
        "buildingIncome": { "type": "object" },
        "categoryExpense": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/managers/{managerId}": { "schema": "Manager", "description": "Managers list" },
    "/buildings/{buildingId}": { "schema": "Building", "description": "Buildings list" },
    "/students/{studentId}": { "schema": "Student", "description": "Students list" },
    "/payments/{paymentId}": { "schema": "Payment", "description": "Income records" },
    "/expenses/{expenseId}": { "schema": "Expense", "description": "Expense records" },
    "/summaries/{summaryId}": { "schema": "Summary", "description": "Monthly aggregations" },
    "/expenseParties/{partyId}": { "schema": "ExpenseParty", "description": "Parties for expenses" }
  }
}
