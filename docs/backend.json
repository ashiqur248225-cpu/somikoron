
{
  "entities": {
    "Building": {
      "title": "Building",
      "type": "object",
      "description": "Represents a single hostel building.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "rooms": { "type": "number", "description": "Total rooms in the building" },
        "totalSeats": { "type": "number", "description": "Total capacity of seats" },
        "occupiedSeats": { "type": "number", "description": "Currently occupied seats" },
        "emptySeats": { "type": "number", "description": "Currently vacant seats" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "address", "rooms", "totalSeats"]
    },
    "Student": {
      "title": "Student",
      "type": "object",
      "description": "Represents a student resident.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "buildingId": { "type": "string" },
        "buildingName": { "type": "string" },
        "isActive": { "type": "boolean" },
        "paymentSystem": { "type": "string" },
        "monthlyAmount": { "type": "number" }
      },
      "required": ["id", "name", "buildingId"]
    },
    "Payment": {
      "title": "Payment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "month": { "type": "string" },
        "year": { "type": "string" },
        "studentName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" }
      }
    },
    "Summary": {
      "title": "Monthly Summary",
      "type": "object",
      "description": "Aggregated financial data for a specific month to reduce read costs.",
      "properties": {
        "id": { "type": "string", "description": "Format: YYYY-MonthName" },
        "totalIncome": { "type": "number" },
        "totalExpense": { "type": "number" },
        "buildingIncome": { "type": "object", "description": "Map of building names to income amount" },
        "categoryExpense": { "type": "object", "description": "Map of categories to expense amount" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/managers/{managerId}": { "schema": "Manager", "description": "Managers list" },
    "/buildings/{buildingId}": { "schema": "Building", "description": "Buildings list" },
    "/students/{studentId}": { "schema": "Student", "description": "Students list" },
    "/payments/{paymentId}": { "schema": "Payment", "description": "Income records" },
    "/expenses/{expenseId}": { "schema": "Expense", "description": "Expense records" },
    "/summaries/{summaryId}": { "schema": "Summary", "description": "Monthly aggregations" }
  }
}
