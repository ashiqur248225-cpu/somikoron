
{
  "entities": {
    "Branch": {
      "title": "Branch",
      "type": "object",
      "description": "Represents a hostel branch/location.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "Building": {
      "title": "Building",
      "type": "object",
      "description": "Represents a single hostel building.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "branch": { "type": "string" },
        "apartmentsCount": { "type": "number" },
        "apartmentsDetail": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string", "description": "e.g., Apartment C2" },
              "meterNo": { "type": "string", "description": "Electric meter for this apartment" },
              "rooms": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "roomNo": { "type": "string", "description": "e.g., 301" },
                    "totalSeats": { "type": "number" },
                    "seats": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "seatNo": { "type": "string" },
                          "status": { "type": "string", "enum": ["empty", "occupied"] }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "totalSeats": { "type": "number" },
        "occupiedSeats": { "type": "number" },
        "emptySeats": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "address"]
    },
    "Student": {
      "title": "Student",
      "type": "object",
      "description": "Represents a student resident.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "parentPhone": { "type": "string" },
        "address": { "type": "string" },
        "buildingId": { "type": "string" },
        "buildingName": { "type": "string" },
        "branch": { "type": "string" },
        "apartmentName": { "type": "string" },
        "roomNumber": { "type": "string" },
        "seatNumber": { "type": "string" },
        "type": { "type": "string", "enum": ["new", "old"] },
        "dueAmount": { "type": "number" },
        "advanceAmount": { "type": "number" },
        "serviceCharge": { "type": "number" },
        "isActive": { "type": "boolean" },
        "paymentSystem": { "type": "string", "enum": ["package", "non-package"] },
        "monthlyRent": { "type": "number" },
        "foodCost": { "type": "number" },
        "foodRate": { "type": "number" },
        "paymentsHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string", "format": "date-time" },
              "amount": { "type": "number" },
              "method": { "type": "string" },
              "receiver": { "type": "string" },
              "month": { "type": "string" },
              "year": { "type": "string" },
              "type": { "type": "string" }
            }
          }
        },
        "mealsHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string", "format": "date" },
              "month": { "type": "string" },
              "totalMeals": { "type": "number" },
              "perMealCost": { "type": "number" },
              "totalCost": { "type": "number" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "buildingId", "roomNumber"]
    },
    "Staff": {
      "title": "Staff",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Branch Manager", "Building Manager"] },
        "branch": { "type": "string" },
        "assignedBuildingId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/branches/{branchId}": { "schema": "Branch", "description": "Hostel Branches" },
    "/buildings/{buildingId}": { "schema": "Building", "description": "Buildings list" },
    "/students/{studentId}": { "schema": "Student", "description": "Students list" },
    "/staff/{staffId}": { "schema": "Staff", "description": "Staff and roles" },
    "/payments/{paymentId}": { "schema": "object", "description": "Global Income" },
    "/expenses/{expenseId}": { "schema": "object", "description": "Global Expenses" },
    "/transfers/{transferId}": { "schema": "object", "description": "Fund transfers" }
  }
}
