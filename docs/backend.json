
{
  "entities": {
    "Branch": {
      "title": "Branch",
      "type": "object",
      "description": "Represents a hostel branch/location.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "Building": {
      "title": "Building",
      "type": "object",
      "description": "Represents a single hostel building.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "branch": { "type": "string" },
        "apartmentsCount": { "type": "number" },
        "apartmentsDetail": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "meterNo": { "type": "string" },
              "rooms": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "roomNo": { "type": "string" },
                    "totalSeats": { "type": "number" },
                    "seats": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "seatNo": { "type": "string" },
                          "status": { "type": "string", "enum": ["empty", "occupied"] }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "totalSeats": { "type": "number" },
        "occupiedSeats": { "type": "number" },
        "emptySeats": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "address"]
    },
    "Student": {
      "title": "Student",
      "type": "object",
      "description": "Represents a student resident.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "dob": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "fatherName": { "type": "string" },
        "motherName": { "type": "string" },
        "parentPhone": { "type": "string" },
        "guardianPhone": { "type": "string" },
        "village": { "type": "string" },
        "postOffice": { "type": "string" },
        "upazila": { "type": "string" },
        "district": { "type": "string" },
        "address": { "type": "string" },
        "school": { "type": "string" },
        "schoolSession": { "type": "string" },
        "college": { "type": "string" },
        "collegeSession": { "type": "string" },
        "university": { "type": "string" },
        "universitySession": { "type": "string" },
        "department": { "type": "string" },
        "session": { "type": "string" },
        "companyName": { "type": "string" },
        "designation": { "type": "string" },
        "occupation": { "type": "string" },
        "buildingId": { "type": "string" },
        "buildingName": { "type": "string" },
        "branch": { "type": "string" },
        "roomNumber": { "type": "string" },
        "seatNumber": { "type": "string" },
        "apartmentName": { "type": "string" },
        "isActive": { "type": "boolean" },
        "monthlyRent": { "type": "number" },
        "serviceCharge": { "type": "number" },
        "advanceAmount": { "type": "number" },
        "billingStartDate": { "type": "string" },
        "paymentSystem": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Staff": {
      "title": "Staff",
      "type": "object",
      "description": "Represents a staff member (Management or Working).",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "role": { "type": "string" },
        "staffType": { "type": "string", "enum": ["management", "working"] },
        "monthlySalary": { "type": "number" },
        "branch": { "type": "string" },
        "assignedBuildingId": { "type": "string" },
        "password": { "type": "string" },
        "salaryHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "amount": { "type": "number" },
              "month": { "type": "string" },
              "year": { "type": "string" },
              "date": { "type": "string", "format": "date-time" },
              "method": { "type": "string" }
            }
          }
        }
      }
    },
    "ManagerRequest": {
      "title": "Manager Request",
      "type": "object",
      "description": "Income or Expense approval requests from Building Managers.",
      "properties": {
        "id": { "type": "string" },
        "requestType": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "branch": { "type": "string" },
        "buildingName": { "type": "string" },
        "requestedByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "FoodCostBreakdown": {
      "title": "Food Cost Breakdown",
      "type": "object",
      "description": "Daily food cost and meal count tracking.",
      "properties": {
        "id": { "type": "string" },
        "expenseId": { "type": "string" },
        "branch": { "type": "string" },
        "branchName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "amount": { "type": "number" },
        "totalMeals": { "type": "number" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "NetBalance": {
      "title": "Net Balance",
      "type": "object",
      "description": "Pre-calculated balances for a branch to optimize dashboard reads.",
      "properties": {
        "branchId": { "type": "string" },
        "totalCash": { "type": "number" },
        "totalBkash": { "type": "number" },
        "totalNagad": { "type": "number" },
        "totalBank": { "type": "number" },
        "totalHandCash": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["anonymous", "password"]
  },
  "firestore": {
    "/branches/{branchId}": { "schema": "Branch", "description": "Hostel Branches" },
    "/buildings/{buildingId}": { "schema": "Building", "description": "Buildings list" },
    "/students/{studentId}": { "schema": "Student", "description": "Residents list" },
    "/staff/{staffId}": { "schema": "Staff", "description": "Staff directory" },
    "/payments/{paymentId}": { "schema": "object", "description": "Income transactions" },
    "/expenses/{expenseId}": { "schema": "object", "description": "Expense records" },
    "/transfers/{transferId}": { "schema": "object", "description": "Inter-account transfers" },
    "/managerRequests/{requestId}": { "schema": "ManagerRequest", "description": "Pending approval requests" },
    "/registrations/{regId}": { "schema": "object", "description": "Public admission forms" },
    "/configs/{configId}": { "schema": "object", "description": "Global settings" },
    "/foodCostBreakdown/{id}": { "schema": "FoodCostBreakdown", "description": "Daily food cost analysis" },
    "/netBalance/{branchName}": { "schema": "NetBalance", "description": "Consolidated balances per branch" }
  }
}
