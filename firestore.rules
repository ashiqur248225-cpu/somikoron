
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if a user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Allow all authenticated users to read and write to any document.
    // This recursive rule ensures that all existing and future collections 
    // (like meals, students, payments, summaries) are accessible without 
    // individual permission errors, fulfilling the prototype's requirements.
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
